# FreelanceLeads API Configuration
# Copy this to .env and fill in your API keys

# Google Cloud API Key (enables: Places API, PageSpeed Insights, Custom Search)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable APIs: Places API (New), PageSpeed Insights API, Custom Search JSON API
GOOGLE_CLOUD_API_KEY=

# Google Gemini API Key (enables: AI pitch generation, AI website generation)
# Get from: https://aistudio.google.com/apikey (use AI Studio, not Cloud Console)
GEMINI_API_KEY=

# Google Custom Search Engine ID (optional, enables real SERP analysis)
# Create at: https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_CX=

# JWT Secret (change in production!)
JWT_SECRET=dev-secret-change-me

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
